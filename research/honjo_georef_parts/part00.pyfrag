@dataclass
class SourceRecord:
    source_id: str
    url: str
    path: str | None
    status: str
    bytes: int | None = None
    sha256: str | None = None
    content_type: str | None = None
    note: str | None = None


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def download(source_id: str, url: str, filename: str, *, min_bytes: int = 100) -> SourceRecord:
    dest = RAW / filename
    last_error: str | None = None
    for attempt in range(4):
        try:
            r = SESSION.get(url, timeout=(30, 180), allow_redirects=True)
            r.raise_for_status()
            data = r.content
            if len(data) < min_bytes:
                raise RuntimeError(f"response too small: {len(data)} bytes")
            dest.write_bytes(data)
            return SourceRecord(
                source_id=source_id,
                url=url,
                path=str(dest.relative_to(OUT)),
                status="downloaded",
                bytes=len(data),
                sha256=sha256_file(dest),
                content_type=r.headers.get("content-type"),
            )
        except Exception as exc:  # noqa: BLE001
            last_error = f"{type(exc).__name__}: {exc}"
            time.sleep(2 ** attempt)
    return SourceRecord(source_id, url, None, "failed", note=last_error)


def safe_json(path: Path, obj: Any) -> None:
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2, default=str) + "\n", encoding="utf-8")


def render_pdf_first_page(pdf_path: Path, out_path: Path) -> None:
    doc = fitz.open(pdf_path)
    page = doc[0]
    pix = page.get_pixmap(matrix=fitz.Matrix(2.0, 2.0), alpha=False)
    pix.save(out_path)


def normalise_p83(source_path: Path) -> tuple[Path, Path]:
    image = Image.open(source_path).convert("RGB")
    upright = image.rotate(90, expand=True)
    upright_path = DERIVED / "p83-upright.png"
    upright.save(upright_path)

    overlay = upright.copy()
    draw = ImageDraw.Draw(overlay)
    draw.line(P83_OUTER_PIXELS, fill=(220, 20, 60), width=5, joint="curve")
    for idx, (x, y) in enumerate(P83_OUTER_PIXELS[:-1]):
        if idx % 4 == 0:
            draw.ellipse((x - 4, y - 4, x + 4, y + 4), fill=(0, 80, 220))
    overlay_path = QC / "p83-digitised-outer-qc.png"
    overlay.save(overlay_path)
    return upright_path, overlay_path


def find_tokyo_park_geometry() -> tuple[Any | None, dict[str, Any]]:
    report: dict[str, Any] = {"status": "not_started", "resource": None, "candidates": []}
    try:
        meta = SESSION.get(SOURCES["tokyo_green_ckan"], timeout=60)
        meta.raise_for_status()
        package = meta.json()
        safe_json(RAW / "tokyo-green-package.json", package)
        resources = package.get("result", {}).get("resources", [])
        ranked = []
        for res in resources:
            text = " ".join(str(res.get(k, "")) for k in ("name", "description", "url", "format"))
