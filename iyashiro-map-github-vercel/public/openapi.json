{
  "openapi": "3.1.0",
  "info": {
    "title": "イヤシロ土地判定 API",
    "version": "2.1.0",
    "description": "東京23区・横浜市・川崎市のイヤシロ仮説と現代的土地条件を取得する読み取り専用APIです。クオレガ東京本社4.5km圏と田園都市線の渋谷〜二子玉川・線路中心1km帯は100m間隔で事前計算されています。"
  },
  "paths": {
    "/api/lookup": {
      "get": {
        "operationId": "diagnoseAddress",
        "summary": "住所から土地を診断する",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "住所と診断結果",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/api/diagnose": {
      "get": {
        "operationId": "diagnoseCoordinates",
        "summary": "緯度経度から土地を診断する",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number" }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": { "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "診断結果",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  }
}
