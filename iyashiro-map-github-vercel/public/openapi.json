{
  "openapi": "3.1.0",
  "info": {
    "title": "イヤシロ土地判定・NEXUS API",
    "version": "2.3.0",
    "description": "土地カルテ、NEXUS個人条件、町丁目の公開募集市場を別々に確認する読み取り専用APIです。"
  },
  "paths": {
    "/api/lookup": {
      "get": {
        "operationId": "diagnoseAddress",
        "summary": "住所から土地を診断する",
        "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "住所と診断結果" } }
      }
    },
    "/api/diagnose": {
      "get": {
        "operationId": "diagnoseCoordinates",
        "summary": "緯度経度から土地を診断する",
        "parameters": [
          { "name": "lat", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "lng", "in": "query", "required": true, "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "診断結果" } }
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getLocationProfile",
        "summary": "住所または座標から土地カルテを取得する",
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "lat", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "lng", "in": "query", "required": false, "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "研究レイヤーを分離した土地カルテ" } }
      }
    },
    "/api/nexus": {
      "get": {
        "operationId": "assessPropertyPolicy",
        "summary": "物件条件と町丁目の公開募集市場を分けて判定する",
        "parameters": [
          { "name": "total", "in": "query", "required": false, "description": "月額固定費合計", "schema": { "type": "number" } },
          { "name": "area", "in": "query", "required": false, "description": "専有面積（㎡）", "schema": { "type": "number" } },
          { "name": "floor", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "address", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "town", "in": "query", "required": false, "description": "町丁目。住所入力時は画面側で自動補完可能", "schema": { "type": "string" } },
          { "name": "currentness", "in": "query", "required": false, "schema": { "type": "string", "enum": ["confirmed", "stale", "unknown"] } },
          { "name": "identity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["exact", "partial", "unknown"] } }
        ],
        "responses": {
          "200": { "description": "条件ゲート、単純市場中央値、次の確認事項" },
          "400": { "description": "入力形式が不正" }
        }
      },
      "post": {
        "operationId": "assessPropertyPolicyJson",
        "summary": "JSONで物件条件と町丁目市場を判定する",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "条件ゲートと市場文脈" },
          "400": { "description": "入力形式が不正" }
        }
      }
    }
  }
}
